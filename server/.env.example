# --- Core ---
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# --- AI provider (swappable via AI_PROVIDER: "ollama" | "anthropic") ---
# Default is "ollama" - a local model, no API key or billing account needed.
# Install Ollama (https://ollama.com) on whatever machine runs this server,
# then pull a tool-calling-capable model and a vision model:
#   ollama pull llama3.1
#   ollama pull llava
# and just run the Ollama app/daemon - the server talks to it over localhost.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_VISION_MODEL="llava"

# --- Only used when AI_PROVIDER="anthropic" ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_VISION_MODEL="claude-sonnet-5"

# --- Free tier usage cap (Section 15) ---
FREE_DAILY_CHAT_CAP=15

# --- Auth providers (swappable via AUTH_PROVIDER list) ---
APPLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# --- Push (swappable via PUSH_PROVIDER: expo | fcm | apns) ---
PUSH_PROVIDER="expo"
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# --- Subscriptions (swappable via IAP_PROVIDER) ---
APPLE_SHARED_SECRET=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GRANDMA_PLUS_MONTHLY_PRODUCT_ID="grandma_plus_monthly"
GRANDMA_PLUS_ANNUAL_PRODUCT_ID="grandma_plus_annual"

# --- Ads (swappable via ADS_PROVIDER) ---
ADS_PROVIDER="admob"
ADMOB_APP_ID_IOS=""
ADMOB_APP_ID_ANDROID=""
